# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR API & SEGURIDAD
# ==============================================================================
PORT=4000
NODE_ENV=development

# URL pública del Frontend (para políticas CORS y redirecciones OAuth)
FRONTEND_URL=http://localhost:5173

# Secreto para firma de tokens JWT de sesión (mínimo 32 caracteres)
JWT_SECRET=desarrollo_secreto_super_seguro_para_firmar_jwt_de_aig_portfolio_2026

# Duración de la sesión en horas
SESSION_TTL_HOURS=8

# ==============================================================================
# ORIGEN DE DATOS (DATA SOURCE)
# ==============================================================================
# 'database' = Conexión directa a SQL Server On-Premises (Solo Lectura)
# 'file'     = Modo histórico vía semilla HTML + cargas de archivos Excel
DATA_SOURCE=database

# ==============================================================================
# CONEXIÓN A BASE DE DATOS (MICROSOFT SQL SERVER ON-PREMISES)
# ==============================================================================
# Dirección IP o nombre de host del servidor de base de datos
DB_HOST=192.168.1.81
DB_PORT=1433
# Nombre de la instancia (dejar en blanco para la instancia por defecto)
DB_INSTANCE=
# Base de datos transaccional / analítica de cartera
DB_NAME=RESUMENAIG
# Credenciales de acceso (autenticación SQL Server con permisos estrictos db_datareader)
DB_USER=HenryAIG
DB_PASSWORD=
# Nombre de la aplicación que se reporta en sys.sysprocesses
DB_APP_NAME=aig-portfolio-dashboard

# SEGURIDAD DE TRANSPORTE Y CIFRADO (TLS / SSL)
# DB_ENCRYPT: true (TDS 7.x con TLSv1.2+) | strict (TDS 8.0, SQL Server 2022+)
DB_ENCRYPT=true
# En LAN o entorno de pruebas con certificados autofirmados: true
# En producción estricta: false y especificar DB_CA_CERT_PATH
DB_TRUST_SERVER_CERT=true
# Ruta al certificado de la Entidad Certificadora (CA) para validar el servidor en producción
DB_CA_CERT_PATH=
# Nombre de host esperado en el certificado TLS (si difiere de la IP)
DB_TLS_SERVERNAME=

# Enrutamiento de solo lectura (ApplicationIntent=ReadOnly para Availability Groups / Réplicas)
DB_READ_ONLY_INTENT=true

# CONFIGURACIÓN DEL POOL DE CONEXIONES & RESILIENCIA
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=60000
DB_MAX_RETRIES=5
DB_RETRY_BASE_MS=1000
DB_HEALTH_INTERVAL_MS=60000

# INTERVALO DE REFRESCADO DINÁMICO DE CARTERA
# Frecuencia en minutos para refrescar el cierre activo automáticamente (0 = manual)
DB_REFRESH_MINUTES=15

# ==============================================================================
# CIFRADO DE CAPA DE TRANSPORTE API (HTTPS / TLS NATIVO - OPCIONAL)
# ==============================================================================
# Habilita HTTPS nativo en el servidor Express (recomendado si no se utiliza reverse proxy Nginx/Caddy)
HTTPS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# ==============================================================================
# PERSISTENCIA LOCAL & ARCHIVOS SEMILLA (FALLBACK / MODO ARCHIVO)
# ==============================================================================
SEED_HTML_PATH=../Dashboard_Cartera_AIG.html
DATA_DIR=./data
MAX_UPLOAD_MB=25

# ==============================================================================
# CONTROL DE ACCESO (USUARIOS Y GOOGLE OAUTH2)
# ==============================================================================
# Formato: email:bcrypt_hash:rol:Nombre Completo;...
# Cuentas demo preconfiguradas para desarrollo si se deja vacío:
# 1) riesgos@apoyointegral.com.gt / Cartera2026! (Rol: admin)
# 2) direccion@apoyointegral.com.gt / Direccion2026! (Rol: analyst)
AUTH_USERS=

# Integración Google OAuth2 (Sign-In with Google / ID Token Verification)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secreto
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=apoyointegral.com.gt,fusai.org
GOOGLE_SIMULATION=false
ADMIN_EMAILS=riesgos@apoyointegral.com.gt
GOOGLE_DEFAULT_ROLE=analyst
