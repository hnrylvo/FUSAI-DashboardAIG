# Puerto del backend
PORT=4000
NODE_ENV=development

# URL pública del Frontend (para CORS y redirecciones OAuth)
FRONTEND_URL=http://localhost:5173

# Secreto para firma de JWT (mínimo 32 caracteres)
JWT_SECRET=desarrollo_secreto_super_seguro_para_firmar_jwt_de_aig_portfolio_2026

# Duración de la sesión en horas
SESSION_TTL_HOURS=8

# Ruta relativa o absoluta al HTML original con los datos semilla
SEED_HTML_PATH=../Dashboard_Cartera_AIG.html

# Directorio de persistencia para cierres cargados dinámicamente (.xlsx)
DATA_DIR=./data

# Tamaño máximo de subida de archivo (MB)
MAX_UPLOAD_MB=25

# Usuarios en formato: email:bcrypt_hash:rol:Nombre Completo;... (separados por punto y coma)
# Si no se define en development, se usan los usuarios demo por defecto:
# 1) riesgos@apoyointegral.com.gt / Cartera2026! (Rol: admin)
# 2) direccion@apoyointegral.com.gt / Direccion2026! (Rol: analyst)
AUTH_USERS=

# Integración Google OAuth2 (Opcional en dev, simulación automática si no se definen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=apoyointegral.com.gt,fusai.org
GOOGLE_SIMULATION=true
ADMIN_EMAILS=riesgos@apoyointegral.com.gt
GOOGLE_DEFAULT_ROLE=analyst
